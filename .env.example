# Kredensial API developer dari https://my.telegram.org (wajib)
# Cara mendapatkannya: my.telegram.org > Tools > API development credentials
API_ID=
API_HASH=

# Nomor akun Telegram yang dipakai login, format internasional tanpa "+".
# Contoh: 6281234567890. Boleh dikosongkan, lalu ditanya di console.
PHONE=

# Isi HANYA kalau console tidak bisa menerima input (mis. dijalankan dari
# IDE atau service). Kode OTP ini hanya dipakai sekali, lalu bisa dihapus.
OTP_CODE=

# Password two-step verification, untuk kondisi yang sama seperti di atas.
TWOFA_PASSWORD=

# ID user admin bot, pisahkan dengan koma. Contoh: 123456789,987654321
# Kosongkan saja bila akun ini milikmu sendiri — otomatis jadi admin.
# Perintah admin (/perms /admins /members /admin /stat) terbuka untuk
# pemilik bot, admin grup, dan ID yang terdaftar di sini.
ADMIN_IDS=

# ID grup yang diizinkan (whitelist), pisahkan dengan koma.
# Semua angka harus negatif, contoh: -1001234567890.
# Kosongkan = hanya chat pribadi yang dilayani.
# Cari ID-nya lewat perintah /groups.
# CATATAN: ini hanya berlaku untuk PERINTAH. Ucapan otomatis (/salam dan
# /pamit) tetap jalan di SEMUA grup yang diikuti akun ini.
ALLOWED_GROUP_IDS=

# Ucapan otomatis saat member bergabung atau keluar. Berjalan di semua
# grup yang diikuti akun ini, tidak perlu daftarkan di ALLOWED_GROUP_IDS.
# Set 0 untuk mematikan. Ulangi per jenis bila hanya salah satu yang dimatikan.
WELCOME_ENABLED=1
GOODBYE_ENABLED=1

# Template bawaan untuk ucapan, boleh dikosongkan. Penanda yang bisa dipakai:
# {nama} {grup} {jumlah} {baris} {ctx} {judul}
# Setting per grup lewat perintah /salam dan /pamit lebih diutamakan,
# hasilnya disimpan di data/ucapan.json.
WELCOME_TEXT=
GOODBYE_TEXT=

# Gambar untuk perintah /menu. Path relatif dari folder project ini.
# Boleh dikosongkan: bila folder data/foto/ kosong, bot memakai foto profil
# Telegram-nya sendiri. Format yang dicari: .jpg .jpeg .png .webp
MENU_IMAGE=

# Jeda minimum antar pesan otomatis (detik). Balasan pertama dikirim
# langsung; jeda hanya berlaku untuk pesan berikutnya yang beruntun.
# Naikkan kalau sering terkena permintaan "flood wait".
SEND_DELAY=0.3

# Level logging: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
